    {
      "id": "b3c0d1e2-0005-4d2e-8b31-000000000005",
      "name": "Build updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Find jobs whose status changed, and build each update.\n// Input: Settings, every row of \"Jobs\" and of \"Update Log\".\n// Output: one item per changed job, with action = post | skip | queued.\nconst cfg = $('Settings').first().json;\nconst jobs = $('Read jobs').all().map(i => i.json);\nconst log = $('Read update log').all().map(i => i.json);\nconst seen = {}, queuedSeen = {};\nfor (const r of log) {\n  if (!r.Key || ['skipped', 'error'].includes(r.Result)) continue;\n  if (r.Result === 'queued') queuedSeen[r.Key] = true; else seen[r.Key] = r.Result;\n}\n// Approve the first 5: a person sends the held draft from Gmail, then changes its log row\n// from \"person\" to \"approved\". Approved rows are counted per vendor.\nconst vendorOfJob = {};\nfor (const j of jobs) vendorOfJob[j['Job ID']] = j.Vendor;\nconst approvedCount = {};\nfor (const r of log) if (r.Result === 'approved') { const v = vendorOfJob[r['Job ID']]; approvedCount[v] = (approvedCount[v] || 0) + 1; }\n\nconst VENDORS = {\n  'Bluepeak Protection Plans': { audience: 'vendor', domain: 'bluepeak-protection.example', style: 'vendor' },\n  'Harbor Appliance Care':     { audience: 'vendor', domain: 'harbor-appliance.example', style: 'vendor' },\n  'Northstar Home Warranty':   { audience: 'vendor', domain: 'northstar-warranty.example', style: 'vendor' },\n  'Direct customer':           { audience: 'homeowner', style: 'homeowner' },\n};\nconst tz = cfg.timezone;\nconst fmt = (d, o) => d ? new Date(d).toLocaleString('en-US', Object.assign({ timeZone: tz }, o)) : '';\nconst hourNow = Number(new Date().toLocaleString('en-US', { timeZone: tz, hour: 'numeric', hourCycle: 'h23' }));\nconst quiet = hourNow >= cfg.quietFrom || hourNow < cfg.quietTo;\n\nfunction keyOf(j) {\n  const d = j['Window Start'] || j['Part ETA'];\n  return [j['Job ID'], j.Status, d ? new Date(d).toISOString().slice(0, 16) : ''].filter(Boolean).join('|');\n}\nfunction render(v, j) {\n  const claim = j['Claim #'], tech = j.Tech || 'a Summit technician', first = String(j.Customer || '').split(' ')[0];\n  const win = fmt(j['Window Start'], { dateStyle: 'short', timeStyle: 'short' }) + '–' + fmt(j['Window End'], { timeStyle: 'short' });\n  if (v.style === 'vendor') {\n    const t = {\n      received: `Claim ${claim}: received and accepted by Summit Home Services (our job ${j['Job ID']}). We will contact the homeowner and post the appointment on this thread.`,\n      scheduled: `Claim ${claim}: appointment set for ${win}. Technician: ${tech}.`,\n      rescheduled: `Claim ${claim}: appointment moved to ${win} at the homeowner's request. Technician: ${tech}.`,\n      en_route: `Claim ${claim}: technician ${tech} is on the way. ETA ${fmt(j.ETA, { timeStyle: 'short' })}.`,\n      waiting_parts: `Claim ${claim}: diagnosed, waiting on parts. Part: ${j.Part}, ETA ${fmt(j['Part ETA'], { dateStyle: 'short' })}. We will post the return visit here.`,\n      completed: `Claim ${claim}: completed. Work done: ${j['Work Done']}. Completion report attached.`,\n    }[j.Status];\n    return t + '\\n\\nSummit Home Services dispatch · (555) 010-4400\\nAutomated update. Reply here and a person will read it.';\n  }\n  const day = fmt(j['Window Start'], { weekday: 'long', month: 'short', day: 'numeric' });\n  const t = {\n    received: `Hi ${first}, thanks for getting in touch. We have your request (job ${j['Job ID']}). Someone will call you within 4 hours to set a time.`,\n    scheduled: `Hi ${first}, you're booked: ${tech} will come ${day}, ${win.split(', ')[1] || ''}.`,\n    rescheduled: `Hi ${first}, as you asked, we've moved your appointment to ${day}.`,\n    en_route: `Hi ${first}, ${tech.split(' ')[0]} is on the way and should be with you around ${fmt(j.ETA, { timeStyle: 'short' })}.`,\n    waiting_parts: `Hi ${first}, the ${String(j.Part).toLowerCase()} needs replacing. It's ordered and should arrive ${fmt(j['Part ETA'], { weekday: 'long', month: 'short', day: 'numeric' })}.`,\n    completed: `Hi ${first}, all done. ${j['Work Done']} Your report is attached. Thanks for choosing Summit!`,\n  }[j.Status];\n  return t + '\\n\\nSummit Home Services · (555) 010-4400\\nJust reply to this email if anything changes.';\n}\n\nconst out = [];\nfor (const j of jobs) {\n  if (!j['Job ID'] || !j.Status) continue;\n  const key = keyOf(j);\n  if (String(j['Last Notified Key']) === key) continue;                 // nothing new\n  const v = VENDORS[j.Vendor] || VENDORS['Direct customer'];\n  const base = { jobId: j['Job ID'], status: j.Status, key, vendor: j.Vendor, row: j.row_number };\n  // Never twice\n  if (seen[key] === 'person') continue;                                // waiting for a person; never retried by itself\n  if (seen[key]) { out.push({ json: { ...base, action: 'skip', note: 'Already ' + seen[key] + ', skipped' } }); continue; }\n  // Quiet hours for homeowners: not now. The first run after 7 AM picks it up.\n  if (v.audience === 'homeowner' && quiet) {\n    if (!queuedSeen[key]) out.push({ json: { ...base, action: 'queued', note: 'Quiet hours: waits until 7:00 AM' } });\n    continue;\n  }\n  const who = v.audience === 'homeowner' ? String(j['Customer Email']).toLowerCase() : v.domain;\n  const isNew = (cfg.newTemplates || '').split(',').map(s => s.trim()).includes(j.Vendor);\n  out.push({ json: { ...base, action: 'post', text: render(v, j), who, claim: j['Claim #'] || '', threadId: j['Thread ID'] || '',\n    query: `\"${j['Claim #']}\" from:${who} newer_than:180d -in:drafts`,\n    needsApproval: isNew && (approvedCount[j.Vendor] || 0) < cfg.approveFirst, shadow: cfg.shadowMode } });\n}\nreturn out;"
      }
    },
