    },
    {
      "id": "b3c0d1e2-0019-4d2e-8b31-000000000019",
      "name": "Mark held",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Everything that needs a person: no thread, two threads, an unread customer reply, or a new template.\nreturn { json: { ...$json, result: 'person', note: $json.why || $json.note } };"
      }
    },
    {
      "id": "b3c0d1e2-0020-4d2e-8b31-000000000020",
      "name": "Done with this update?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3740,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
