    {
      "id": "b3c0d1e2-0008-4d2e-8b31-000000000008",
      "name": "Right thread?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Right thread or no send: exactly one thread, or a person decides.\nconst job = $('Build updates').item.json;\nconst r = $json;\nlet ids = [];\nif (job.threadId) ids = r.id ? [r.id] : [];                    // saved thread: fetched by ID\nelse ids = (r.threads || []).map(t => t.id);                   // search by claim #\nconst why = ids.length === 0\n  ? `No thread matches ${job.claim || job.jobId}. It never starts a new thread.`\n  : `${ids.length} threads match claim ${job.claim}. It will not guess which one the vendor is watching.`;\nreturn { json: { ...job, matchCount: ids.length, threadId: ids.length === 1 ? ids[0] : '', why: ids.length === 1 ? '' : why } };"
      }
    },
    {
      "id": "b3c0d1e2-0009-4d2e-8b31-000000000009",
      "name": "Exactly one thread?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.matchCount === 1 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b3c0d1e2-0010-4d2e-8b31-000000000010",
      "name": "Get thread messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/threads/' + $json.threadId + '?format=metadata&metadataHeaders=From&metadataHeaders=Subject&metadataHeaders=Message-ID&metadataHeaders=Reply-To' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE",
          "name": "Gmail (dispatch@example.com)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "b3c0d1e2-0011-4d2e-8b31-000000000011",
      "name": "Customer replied?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Customer replied? If the newest message is from them and UNREAD, pause and ask a person.\n// Otherwise build the reply as a raw RFC 822 message with the right Re: subject and headers.\nconst job = $('Right thread?').item.json;\nconst msgs = $json.messages || [];\nconst last = msgs[msgs.length - 1] || {};\nconst hdr = (m, n) => ((m.payload || {}).headers || []).find(h => h.name.toLowerCase() === n.toLowerCase())?.value || '';\nconst lastFrom = hdr(last, 'From').toLowerCase();\nconst fromUs = lastFrom.includes($('Settings').first().json.ourAddress.toLowerCase());\nconst unread = (last.labelIds || []).includes('UNREAD');\nif (!fromUs && unread) {\n  return { json: { ...job, paused: true, why: `${hdr(last, 'From')} wrote on this thread and nobody has read it. Updates here are paused.` } };\n}\nconst subject0 = hdr(msgs[0] || {}, 'Subject');\nconst subject = /^re:/i.test(subject0) ? subject0 : 'Re: ' + subject0;\nconst refs = msgs.map(m => hdr(m, 'Message-ID')).filter(Boolean).join(' ');\nconst to = hdr(msgs[0] || {}, 'Reply-To') || hdr(msgs[0] || {}, 'From');\nconst raw = [\n  `To: ${to}`, `Subject: ${subject}`, `In-Reply-To: ${hdr(last, 'Message-ID')}`, `References: ${refs}`,\n  'Content-Type: text/plain; charset=UTF-8', '', job.text,\n].join('\\r\\n');\nconst b64 = Buffer.from(raw, 'utf8').toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');\nreturn { json: { ...job, paused: false, raw: b64 } };"
      }
    },
    {
