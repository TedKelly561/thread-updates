    {
      "id": "b3c0d1e2-0015-4d2e-8b31-000000000015",
      "name": "Mark draft result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Count a send toward \"approve the first 5\" only when a person approves it.\n// (A person sends the draft from Gmail; this node only records that a draft was made.)\nreturn { json: { ...$('Draft only? (shadow or approval)').item.json, result: $('Draft only? (shadow or approval)').item.json.needsApproval ? 'person' : 'drafted', note: $('Draft only? (shadow or approval)').item.json.needsApproval\n  ? 'New template: draft waiting for a person to approve (send it from Gmail)' : 'SHADOW: draft on thread ' + $('Draft only? (shadow or approval)').item.json.threadId } };"
      }
    },
