        "text": "=*Needs a person: {{ $json.jobId }} {{ $json.status }} update was NOT posted*\n{{ $json.why || $json.note }}\nKey: `{{ $json.key }}`\n\nThe update it was going to post:\n```{{ $json.text }}```",
        "otherOptions": {}
